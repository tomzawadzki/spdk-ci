# The menus of review.spdk.io. This file goes into refs/meta/config of
# All-Projects, see config.md of the plugin.
#
# Review has a dashboard for each role. Most sections list only the first
# change of a series that needs work, since one action there moves the whole
# series. Gerrit orders a section by last update, so the sections of a
# dashboard come in the order they need attention, and no change is in two
# of them.

[fragment]
	# CI passed. Only spdk/spdk has CI, elsewhere a maintainer gives
	# Verified by hand.
	ciOk = (label:Verified=1 OR -project:spdk/spdk)
	# Review the owner has to answer, or has answered and waits on.
	rev = (label:Code-Review<0 OR has:unresolved)
	noRev = -label:Code-Review<0 -has:unresolved
	approved = label:Code-Review=2 -label:Code-Review<0
	# Has to be rebased before a vote or a submit helps. A change 4 weeks
	# behind its branch is outdated, and the outdated changes job votes
	# Verified -1 on it.
	rebase = (-is:mergeable OR stack_stacks:broken OR behind_stacks:4w)
	# Nothing for the owner to do before the next review.
	reviewable = is:mergeable -stack_stacks:broken -behind_stacks:4w ${ciOk} -label:Verified-1 ${noRev}
	# Not ready and nothing to rebase or fix in CI.
	settled = -stack_stacks:ready -${rebase} -label:Verified-1
	# A blocker that only waits on review, CI or time.
	quiet = stack_stacks:blocked -${rebase} -label:Verified-1 ${noRev}

[menu "Review"]
	item = My series, to do
	item = My series, waiting
	item = Needs review
	item = Watched and starred
	item = Maintainer review
	item = Ready to submit

[menu "CI queue"]
	item = Queue status
	item = GitHub Workflow status

# For change owners. Every open change of the user is in exactly one section
# of these two dashboards. They are two to keep each URL short enough for
# browser XSS filters.
[dashboard "My series, to do"]
	signedIn = true
	foreach = owner:self
	# Nothing else helps until it is rebased.
	section = Rebase now
	query = -is:wip -stack_stacks:ready ${rebase}
	# Fix the failure, or retrigger CI if the change did not cause it.
	section = Fix CI
	query = -is:wip -stack_stacks:ready -${rebase} label:Verified-1
	# Reply, or upload a new patch set.
	section = Answer review
	query = -is:wip ${settled} ${rev} attention:self
	# Waits on nothing else, rebase it before it is outdated.
	section = Rebase soon
	query = -is:wip ${quiet} behind_stacks:2w
	section = Work in progress
	query = is:wip

[dashboard "My series, waiting"]
	signedIn = true
	foreach = owner:self -is:wip
	# The reviewer has to answer.
	section = Waiting for reviewer reply
	query = ${settled} ${rev} -attention:self
	# Check the CI queue if it takes long.
	section = CI not run
	query = ${quiet} -behind_stacks:2w project:spdk/spdk -label:Verified=1
	# It is in Needs review or Maintainer review.
	section = Waiting for review
	query = ${quiet} -behind_stacks:2w ${ciOk}
	# The next submit of the series takes it along.
	section = Waiting for merge
	query = stack_stacks:ready
	# A change lower in the series needs work first.
	section = Waiting on a change below
	query = ${settled} -stack_stacks:blocked ${noRev}

# For reviewers, the first change of each series without a +2. After its
# first +2 a change moves to Maintainer review.
[dashboard "Needs review"]
	foreach = stack_stacks:blocked -is:wip ${reviewable} -label:Code-Review=2
	# Review it before it is outdated.
	section = No review yet, over 2 weeks old
	query = -label:Code-Review=ANY behind_stacks:2w
	# A +2 voter can approve it.
	section = Reviewed, needs an approval
	query = label:Code-Review=1
	section = No review yet
	query = -label:Code-Review=ANY -behind_stacks:2w

# For component maintainers, every change in the paths they watch or that
# they starred. Set the paths in Settings > Notifications, with a filter such
# as directory:lib/nvme.
[dashboard "Watched and starred"]
	signedIn = true
	foreach = (is:watched OR is:starred) -owner:self -is:wip
	section = Your turn
	query = attention:self
	section = Not voted yet
	query = -attention:self ${reviewable} -label:Code-Review=ANY,user=self

# For maintainers, the first change of each series that waits on a +2 voter.
[dashboard "Maintainer review"]
	foreach = stack_stacks:blocked -is:wip
	# A second +2 makes it ready to submit.
	section = Needs a second approval
	query = ${reviewable} label:Code-Review=2,count=1
	# Outside spdk/spdk give Verified, on spdk/spdk see which requirement is missing.
	section = Approved, needs Verified
	query = ${reviewable} label:Code-Review=2 -label:Code-Review=2,count=1
	# Rebase it, or ask the owner to, and it keeps its votes.
	section = Approved, needs rebase
	query = ${approved} ${rebase}
	# Ask the owner whether it is still wanted, or abandon it.
	section = Outdated over 4 weeks, not approved
	query = behind_stacks:4w -(${approved})

# For whoever submits, the change to press Submit on. Submitting it also
# submits the open changes below it.
[dashboard "Ready to submit"]
	foreach = stack_stacks:submit
	section = Whole series
	query = stack_stacks:leaf
	# The changes above it still need work, submitting merges the ready part.
	section = Partial series
	query = -stack_stacks:leaf

[link "Queue status"]
	url = /queue_status.html

# The runs of the Gerrit webhook handler, in a new tab.
[link "GitHub Workflow status"]
	url = https://github.com/spdk/spdk-ci/actions/workflows/gerrit-webhook-handler.yml?query=event%3Arepository_dispatch
	target = _blank
