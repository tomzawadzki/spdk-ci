CIJoe 0.9.60 with the upstream change that reads command output in blocks
and decodes it across reads. install_cijoe applies it until a CIJoe release
includes it.

diff --git a/cijoe/core/command.py b/cijoe/core/command.py
index 6778ba6..748f8b1 100644
--- a/cijoe/core/command.py
+++ b/cijoe/core/command.py
@@ -2,6 +2,7 @@
 
 """
 
+import codecs
 import logging as log
 import os
 import sys
@@ -52,8 +53,12 @@ class Tee:
         self.buffer = []
         self.buffer_size = 0
 
+        # A read can end inside a multi-byte character. The decoder holds on to
+        # those bytes until the rest of the character arrives.
+        self.decoder = codecs.getincrementaldecoder(ENCODING)(errors="replace")
+
     def write(self, data: bytes):
-        decoded = data.decode(ENCODING, errors="replace")
+        decoded = self.decoder.decode(data)
         self.buffer.append(decoded)
         self.buffer_size += len(decoded)
 
@@ -74,6 +79,10 @@ class Tee:
         self.buffer_size = 0
 
     def close(self):
+        # Pass on what the decoder still holds, as U+FFFD if the output was cut
+        # off inside a character
+        self.buffer.append(self.decoder.decode(b"", final=True))
+        self.flush()
         self.file.close()
 
     def __enter__(self):
