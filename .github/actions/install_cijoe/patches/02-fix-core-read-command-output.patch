+class Writes:
+    """Takes a command's output as a Tee does, keeping each write"""
+
+    def __init__(self, on_write=None):
+        self.data = []
+        self.on_write = on_write
+
+    def write(self, data):
+        self.data.append(data)
+        if self.on_write:
+            self.on_write()
+
+    def flush(self):
+        pass
+
+
+def test_run_reads_output_in_blocks(ssh_cijoe):
+    """All of the output arrives, in reads of many bytes and at most READ_SIZE"""
+
+    expected = "".join(f"{n}\n" for n in range(1, 100001)).encode()
+    output = Writes()
+
+    assert ssh_cijoe.targets["localhost"].run("seq 1 100000", None, {}, output) == 0
+    assert b"".join(output.data) == expected
+    assert len(output.data) < len(expected) / 100
+    assert max(len(data) for data in output.data) <= READ_SIZE
+
+
+def test_run_passes_output_on_while_the_command_runs(ssh_cijoe, tmp_path):
+    """The command prints its second line only once its first has been read"""
+
+    seen = tmp_path / "seen"
+    path = shlex.quote(str(seen))
+    output = Writes(seen.touch)
+    command = (
+        f"echo first; for i in $(seq 100); do [ -e {path} ] && break; sleep 0.1; done; "
+        f"[ -e {path} ] && echo second"
+    )
+    # The login shell need not be a POSIX one
+    command = f"sh -c {shlex.quote(command)}"
+
+    assert ssh_cijoe.targets["localhost"].run(command, None, {}, output) == 0
+    assert b"".join(output.data) == b"first\nsecond\n"
+
+
+class LosesConnection:
+    """A connected socket that, once armed, is shut down as its next send begins"""
+
+    def __init__(self, address):
+        self.sock = socket.create_connection(address)
+        self.armed = False
+        self.lost = False
+
+    def __getattr__(self, name):
+        return getattr(self.sock, name)
+
+    def send(self, data):
+        if self.armed and not self.lost:
+            self.lost = True
+            self.sock.shutdown(socket.SHUT_RDWR)
+        return self.sock.send(data)
+
+
+def test_run_fails_when_the_connection_is_lost_while_reading(sshd, tmp_path):
+    """The connection is lost as recv() sends a window update: run() returns an
+    error instead of raising, and closes the connection"""
+
+    sock = LosesConnection((sshd["hostname"], sshd["port"]))
+    target = SSH(Config(tmp_path / "config.toml"), tmp_path, {**sshd, "sock": sock})
+
+    def arm():
+        sock.armed = True
+
+    command = "head -c 4000000 /dev/zero; sleep 2"
+
+    assert target.run(command, None, {}, Writes(arm)) == errno.EIO
+    assert sock.lost
+    assert target.ssh.get_transport() is None
+
+
