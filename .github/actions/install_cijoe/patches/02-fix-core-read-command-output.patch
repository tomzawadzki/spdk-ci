+++ b/src/cijoe/core/transport.py
@@ -14,6 +14,10 @@ from scp import SCPClient
 from cijoe.core.misc import deprecated
 from cijoe.core.resources import Config
 
+# The most command output taken per read. A read returns what has arrived, without
+# waiting for this much, so output is passed on while the command runs.
+READ_SIZE = 65536
+
 
 class Transport(ABC):
     @abstractmethod
@@ -54,10 +58,8 @@ class Local(Transport):
             cwd=cwd,
             env=env,
         ) as process:
-            while process.poll() is None:
-                cmd_output.write(process.stdout.read(1))
-
-            cmd_output.write(process.stdout.read())
+            while data := process.stdout.read1(READ_SIZE):
+                cmd_output.write(data)
             cmd_output.flush()
             process.wait()
 
@@ -199,15 +201,17 @@ class SSH(Transport):
             _, stdout, _ = self.ssh.exec_command(cmd, environment=env)
             stdout.channel.set_combine_stderr(True)
 
-            while not stdout.channel.exit_status_ready():
-                cmd_output.write(stdout.read(1))
-
-            cmd_output.write(stdout.read())
+            # Not stdout.read(READ_SIZE), which waits for that many bytes or the end of
+            # the output
+            while data := stdout.channel.recv(READ_SIZE):
+                cmd_output.write(data)
             cmd_output.flush()
 
             err = stdout.channel.recv_exit_status()
             stdout.channel.close()
-        except paramiko.ssh_exception.SSHException as exc:
+        except (paramiko.ssh_exception.SSHException, EOFError) as exc:
+            # recv() raises EOFError if the connection is lost while it sends a window
+            # update
             self.close()
             err = (
                 exc.errno
